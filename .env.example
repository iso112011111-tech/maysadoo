# AI tarot readings — server only, never NEXT_PUBLIC. OpenAI-compatible gateway (/v1/chat/completions).
AI_BASE_URL=https://api.maxplus-ai.cc
AI_API_KEY=
# gemini-3-flash (default) · gemini-2.5-flash (faster) · gemini-3.1-pro-preview (deeper, slower)
AI_MODEL=gemini-3-flash

# SQLite database folder (node:sqlite, built into Node 22.13+). Back this folder up on the VPS.
DATA_DIR=./data
# Salt for hashing visitor IPs (rate limits) — set any long random string in production
HASH_SALT=

# Gemini text-to-speech (แม่หมอ voice). Several keys, comma separated: when one hits its quota it rests and the next is used.
GEMINI_API_KEYS=
# optional: GEMINI_TTS_VOICE=Gacrux   GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# 1-on-1 room with แม่หมอ (paid). Payment is not wired yet: 1 = open to everyone for testing.
PREMIUM_OPEN=0
